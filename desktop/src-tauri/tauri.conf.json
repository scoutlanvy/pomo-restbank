{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomo Restbank",
  "version": "0.1.0",
  "identifier": "com.pomorestbank.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Pomo Restbank",
        "width": 680,
        "height": 850,
        "minWidth": 390,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "main-window",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:allow-close"]
        }
      ],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Build focus. Bank your breaks.",
    "category": "Productivity"
  }
}
